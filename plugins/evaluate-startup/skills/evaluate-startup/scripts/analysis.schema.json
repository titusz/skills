{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/titusz/skills/evaluate-startup/analysis.schema.json",
  "title": "Startup Evaluation Analysis",
  "type": "object",
  "required": ["schema_version", "meta", "idea", "research", "assessment", "scores", "verdict"],
  "properties": {
    "schema_version": { "const": "1.0" },

    "meta": {
      "type": "object",
      "required": ["slug", "name", "one_liner", "evaluated_at"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string" },
        "one_liner": { "type": "string", "maxLength": 200 },
        "evaluated_at": { "type": "string", "format": "date-time" },
        "evaluator": { "type": "string" },
        "skill_version": { "type": "string" },
        "idea_source": { "type": "string" },
        "custom_instructions": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
      }
    },

    "idea": {
      "type": "object",
      "required": ["description", "target_customer", "value_proposition"],
      "properties": {
        "description": { "type": "string" },
        "target_customer": { "type": "string" },
        "value_proposition": { "type": "string" },
        "stage": { "enum": ["concept", "prototype", "revenue", "scaling"] },
        "founder_context": { "type": "string" },
        "interview_notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["q", "a"],
            "properties": { "q": { "type": "string" }, "a": { "type": "string" } }
          }
        }
      }
    },

    "research": {
      "type": "object",
      "required": ["angles"],
      "properties": {
        "conducted_at": { "type": "string" },
        "angles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "summary", "findings"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "findings": { "type": "array", "items": { "type": "string" } },
              "sources": { "$ref": "#/definitions/sources" }
            }
          }
        }
      }
    },

    "assessment": {
      "type": "object",
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "name", "weight", "score", "confidence", "summary", "dimensions"],
            "properties": {
              "id": {
                "enum": ["problem", "market", "leverage", "moat", "economics", "execution"]
              },
              "name": { "type": "string" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 },
              "score": { "type": "number", "minimum": 0, "maximum": 10 },
              "confidence": { "enum": ["low", "medium", "high"] },
              "summary": { "type": "string" },
              "dimensions": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["id", "name", "score", "rationale"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "score": { "type": "number", "minimum": 0, "maximum": 10 },
                    "rationale": { "type": "string" }
                  }
                }
              },
              "sources": { "$ref": "#/definitions/sources" }
            }
          }
        }
      }
    },

    "scores": {
      "type": "object",
      "required": ["composite", "conviction", "band"],
      "properties": {
        "composite": { "type": "number", "minimum": 0, "maximum": 10 },
        "conviction": { "type": "number", "minimum": 0, "maximum": 1 },
        "band": { "enum": ["avoid", "monitor", "explore", "validate", "prototype", "pursue"] }
      }
    },

    "verdict": {
      "type": "object",
      "required": ["recommendation", "confidence", "summary", "strengths", "weaknesses", "risks", "assumptions", "kill_criteria", "validation_plan", "next_steps"],
      "properties": {
        "recommendation": { "enum": ["avoid", "monitor", "explore", "validate", "prototype", "pursue"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "summary": { "type": "string" },
        "strengths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "weaknesses": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["risk", "severity", "likelihood"],
            "properties": {
              "risk": { "type": "string" },
              "severity": { "enum": ["low", "medium", "high", "critical"] },
              "likelihood": { "enum": ["low", "medium", "high"] },
              "mitigation": { "type": "string" }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["assumption", "criticality"],
            "properties": {
              "assumption": { "type": "string" },
              "criticality": { "enum": ["low", "medium", "high"] },
              "current_evidence": { "type": "string" }
            }
          }
        },
        "kill_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "validation_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["question", "method", "success_signal"],
            "properties": {
              "question": { "type": "string" },
              "method": { "type": "string" },
              "effort": { "type": "string" },
              "success_signal": { "type": "string" }
            }
          }
        },
        "next_steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },

    "custom_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "html"],
        "properties": {
          "title": { "type": "string" },
          "html": { "type": "string" }
        }
      }
    }
  },

  "definitions": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
